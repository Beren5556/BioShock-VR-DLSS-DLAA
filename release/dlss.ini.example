; DLSS experimental para BioShock 2 Remastered VR.
; La lanzadera administra %LOCALAPPDATA%\BioshockVR\bs2\dlss.ini.
; "off" conserva DLSS desactivado. No activa el reescalado espacial.
[dlss]
mode=off
runtime=310.7.0
preset=auto
quality=auto
outputWidth=4056
outputHeight=4056

; Clave heredada: BS2 deriva near/far de la proyección WORLD observada por ojo.
; No sustituye los datos observados ni corrige una proyección rechazada.
nearPlaneUu=10.0
