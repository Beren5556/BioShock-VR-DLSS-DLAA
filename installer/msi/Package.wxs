<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="BioShock VR DLSS-DLAA" Manufacturer="Beren5556 · BioShock VR Community"
           Version="$(Version)" ProductCode="$(ProductCode)" UpgradeCode="$(UpgradeCode)"
           Language="3082" Codepage="1252" Scope="perUser" InstallerVersion="500">
    <SummaryInformation Description="BioShock 1 VR · DLSS/DLAA · $(Version)" />
    <MajorUpgrade DowngradeErrorMessage="Ya tienes instalada una versión más reciente de BioShock VR DLSS-DLAA."
                  Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPCOMMENTS" Value="Fork de BioShock VR v0.8.2 de Mohamad Balouza. DLSS/DLAA, optimizaciones y lanzador de Beren5556." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Beren5556/BioShock-VR-DLSS-DLAA" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPPRODUCTICON" Value="ModIcon" />
    <Icon Id="ModIcon" SourceFile="$(RepoRoot)\apps\launcher\assets\BioshockVrLauncher.ico" />
    <Property Id="BVR_GAMEPATH" Secure="yes" />
    <Property Id="GAMEDIR" Secure="yes" />
    <Property Id="BVR_DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="BVR_SHORTCUTINITIALIZED" Secure="yes" />
    <Property Id="BVR_TESTROOT" Secure="yes" />
    <Property Id="BVR_TESTFAIL" Secure="yes" />
    <Property Id="BVR_VALID" Value="0" />
    <Launch Condition="VersionNT64" Message="Este paquete necesita Windows de 64 bits." />

    <StandardDirectory Id="TARGETDIR">
      <Directory Id="GAMEDIR" Name="BioShockVRGame" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <DirectoryRef Id="GAMEDIR">
      <Component Id="InstallRegistration" Guid="$(RegistrationGuid)">
        <RegistryKey Root="HKCU" Key="$(RegistryPath)">
          <RegistryValue Name="GameDirectory" Value="[GAMEDIR]" Type="string" KeyPath="yes" />
          <RegistryValue Name="Version" Value="[ProductVersion]" Type="string" />
          <RegistryValue Name="TestRoot" Value="[BVR_TESTROOT]" Type="string" />
          <RegistryValue Name="DesktopShortcut" Value="[BVR_DESKTOPSHORTCUT]" Type="string" />
        </RegistryKey>
        <RemoveFile Id="RetireUnversionedShortcut" Directory="DesktopFolder" Name="BioShock VR DLSS-DLAA.lnk" On="install" />
      </Component>
      <Component Id="VersionedDesktopLauncher" Guid="$(ShortcutComponentGuid)">
        <RegistryValue Root="HKCU" Key="$(RegistryPath)\Shortcuts" Name="$(Version)"
                       Value="1" Type="integer" KeyPath="yes" />
        <Shortcut Id="DesktopLauncher" Directory="DesktopFolder" Name="BioShock VR DLSS-DLAA $(Version)"
                  Target="[GAMEDIR]Lanzador BioShock VR DLSS-DLAA.exe" WorkingDirectory="GAMEDIR"
                  Icon="ModIcon" Advertise="no" />
      </Component>
    </DirectoryRef>
    <Feature Id="Complete" Title="BioShock VR DLSS-DLAA" Level="1">
      <ComponentGroupRef Id="ModFiles" />
      <ComponentRef Id="InstallRegistration" />
      <Feature Id="DesktopShortcut" Title="Acceso directo de escritorio" Level="1" Display="hidden">
        <ComponentRef Id="VersionedDesktopLauncher" />
      </Feature>
    </Feature>

    <Binary Id="ManagedActions" SourceFile="$(ActionsDll)" />
    <CustomAction Id="DetectGame" BinaryRef="ManagedActions" DllEntry="DetectGame" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateGame" BinaryRef="ManagedActions" DllEntry="ValidateGame" Execute="immediate" Return="check" />
    <CustomAction Id="Prepare" BinaryRef="ManagedActions" DllEntry="Prepare" Execute="immediate" Return="check" />
    <CustomAction Id="RollbackFiles" BinaryRef="ManagedActions" DllEntry="RollbackFiles" Execute="rollback" Impersonate="yes" Return="check" />
    <CustomAction Id="BackupFiles" BinaryRef="ManagedActions" DllEntry="BackupFiles" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="FinishFiles" BinaryRef="ManagedActions" DllEntry="FinishFiles" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="CommitFiles" BinaryRef="ManagedActions" DllEntry="CommitFiles" Execute="commit" Impersonate="yes" Return="check" />
    <InstallUISequence>
      <Custom Action="DetectGame" Before="CostFinalize" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="DetectGame" Before="CostFinalize" />
      <Custom Action="Prepare" Before="InstallValidate" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackFiles" Before="BackupFiles" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="BackupFiles" Before="RemoveShortcuts" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="FinishFiles" After="CreateShortcuts" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CommitFiles" Before="InstallFinalize" Condition="NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <UIRef Id="BioShockUI" />
  </Package>
</Wix>
