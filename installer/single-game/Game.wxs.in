<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Property Id="@Upper@DIR" Secure="yes" />
    <Property Id="BVR_@Upper@_GAMEPATH" Secure="yes" />
    <Property Id="BVR_@Upper@_DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="BVR_@Upper@_SHORTCUTINITIALIZED" Secure="yes" />
    <Property Id="BVR_@Upper@_SELECTED" Secure="yes" />
    <Property Id="BVR_@Upper@_REPAIR" Secure="yes" />
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="@Upper@DIR" Name="BioShockSuite_@Game@" />
    </StandardDirectory>
    <DirectoryRef Id="@Upper@DIR">
      <Component Id="Registration_@Game@" Guid="@RegistrationGuid@">
        <RegistryKey Root="HKCU" Key="@Registry@">
          <RegistryValue Name="GameDirectory" Value="[@Upper@DIR]" Type="string" KeyPath="yes" />
          <RegistryValue Name="Version" Value="[ProductVersion]" Type="string" />
          <RegistryValue Name="TestRoot" Value="[BVR_TESTROOT]" Type="string" />
          <RegistryValue Name="DesktopShortcut" Value="[BVR_@Upper@_DESKTOPSHORTCUT]" Type="string" />
        </RegistryKey>
        <RemoveFile Id="RetireShortcut_@Game@" Directory="DesktopFolder" Name="@Shortcut@.lnk" On="install" />
      </Component>
      <Component Id="ShortcutComponent_@Game@" Guid="@ShortcutGuid@">
        <RegistryValue Root="HKCU" Key="@Registry@\Shortcuts" Name="$(Version)" Value="1" Type="integer" KeyPath="yes" />
        <Shortcut Id="Shortcut_@Game@" Directory="DesktopFolder" Name="@Shortcut@ $(Version)"
                  Target="[@Upper@DIR]@Launcher@" WorkingDirectory="@Upper@DIR" Icon="ModIcon" Advertise="no" />
      </Component>
    </DirectoryRef>
    <Feature Id="Game_@Game@" Title="@DisplayName@ Remastered · VR mod" Level="0" Display="hidden">
      <Level Value="1" Condition="BVR_INSTANCE = &quot;@Game@&quot;" />
      <ComponentGroupRef Id="Files_@Game@" />
      <ComponentRef Id="Registration_@Game@" />
      <Feature Id="Desktop_@Game@" Title="@DisplayName@ shortcut" Level="0" Display="hidden">
        <Level Value="1" Condition="BVR_INSTANCE = &quot;@Game@&quot;" />
        <ComponentRef Id="ShortcutComponent_@Game@" />
      </Feature>
    </Feature>
    <Binary Id="Actions_@Game@" SourceFile="@Actions@" />
    <CustomAction Id="DetectGame_@Game@" BinaryRef="Actions_@Game@" DllEntry="DetectGame" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateGame_@Game@" BinaryRef="Actions_@Game@" DllEntry="ValidateGame" Execute="immediate" Return="check" />
    <CustomAction Id="Prepare_@Game@" BinaryRef="Actions_@Game@" DllEntry="Prepare" Execute="immediate" Return="check" />
    <CustomAction Id="RollbackFiles_@Game@" BinaryRef="Actions_@Game@" DllEntry="RollbackFiles" Execute="rollback" Impersonate="yes" Return="check" />
    <CustomAction Id="BackupFiles_@Game@" BinaryRef="Actions_@Game@" DllEntry="BackupFiles" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="FinishFiles_@Game@" BinaryRef="Actions_@Game@" DllEntry="FinishFiles" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="CommitFiles_@Game@" BinaryRef="Actions_@Game@" DllEntry="CommitFiles" Execute="commit" Impersonate="yes" Return="check" />
    <InstallUISequence>
      <Custom Action="DetectGame_@Game@" Before="@DetectBefore@" Condition="BVR_INSTANCE = &quot;@Game@&quot;" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="DetectGame_@Game@" Before="@DetectBefore@" Condition="NOT UPGRADINGPRODUCTCODE AND BVR_INSTANCE = &quot;@Game@&quot;" />
      <Custom Action="Prepare_@Game@" Before="@PrepareBefore@" Condition="NOT UPGRADINGPRODUCTCODE AND BVR_@Upper@_ACTIVE = &quot;1&quot;" />
      <Custom Action="RollbackFiles_@Game@" Before="BackupFiles_@Game@" Condition="NOT UPGRADINGPRODUCTCODE AND BVR_@Upper@_ACTIVE = &quot;1&quot;" />
      <Custom Action="BackupFiles_@Game@" Before="@BackupBefore@" Condition="NOT UPGRADINGPRODUCTCODE AND BVR_@Upper@_ACTIVE = &quot;1&quot;" />
      <Custom Action="FinishFiles_@Game@" After="@FinishAfter@" Condition="NOT UPGRADINGPRODUCTCODE AND BVR_@Upper@_ACTIVE = &quot;1&quot;" />
      <Custom Action="CommitFiles_@Game@" Before="@CommitBefore@" Condition="NOT UPGRADINGPRODUCTCODE AND BVR_@Upper@_ACTIVE = &quot;1&quot;" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
